#!/usr/bin/env sh

if command -v pre-commit > /dev/null 2>&1; then
  exec pre-commit hook-impl --config=.pre-commit-config.yaml --hook-type=pre-push --hook-dir="$(cd "$(dirname "$0")" && pwd)" -- "$@"
elif python3 -c "import pre_commit" > /dev/null 2>&1; then
  exec python3 -m pre_commit hook-impl --config=.pre-commit-config.yaml --hook-type=pre-push --hook-dir="$(cd "$(dirname "$0")" && pwd)" -- "$@"
fi

# pre-commit is optional in this environment; allow push to continue.
exit 0
